{% extends 'base.html.twig' %}
{% import _self as mis %}

{% block title %}Mis reservas · Hotel Litoral{% endblock %}

{% block body %}
{% set tipoNombre = {SIMPLE: 'Simple', DOBLE: 'Doble', SUITE: 'Suite'} %}
{% set meses = {
    '1': 'enero', '2': 'febrero', '3': 'marzo', '4': 'abril',
    '5': 'mayo', '6': 'junio', '7': 'julio', '8': 'agosto',
    '9': 'septiembre', '10': 'octubre', '11': 'noviembre', '12': 'diciembre'
} %}
{% set pill = {
    PENDIENTE: 'Pendiente',
    CONFIRMADA: 'Confirmada',
    CANCELACION_PENDIENTE: 'Cancelación pendiente',
    CANCELADA: 'Cancelada'
} %}

<div class="crumbs">Inicio › Mis reservas</div>
<h1 class="tripsh">Mis reservas</h1>

{% if proximas is empty and canceladas is empty %}
    <p class="muted">No tenés reservas registradas.</p>
{% else %}
    {% if proximas is not empty %}
        <h2 class="trsec">Próximas</h2>
        <div class="trips">
            {% for reserva in proximas %}
                {{ mis.tarjeta(reserva, tipoNombre, meses, pill) }}
            {% endfor %}
        </div>
    {% endif %}
    {% if canceladas is not empty %}
        <h2 class="trsec">Canceladas</h2>
        <div class="trips">
            {% for reserva in canceladas %}
                {{ mis.tarjeta(reserva, tipoNombre, meses, pill) }}
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
{% endblock %}

{% macro tarjeta(reserva, tipoNombre, meses, pill) %}
    {% set habitacion = reserva.habitacion %}
    {% set portada = null %}
    {% for imagen in habitacion.imagenHabitacions %}
        {% if imagen.portada and portada is null %}
            {% set portada = imagen %}
        {% endif %}
    {% endfor %}
    {% if reserva.fechaIngreso|date('Y-m') == reserva.fechaEgreso|date('Y-m') %}
        {% set periodo = reserva.fechaIngreso|date('j') ~ ' – ' ~ reserva.fechaEgreso|date('j') ~ ' de ' ~ meses[reserva.fechaIngreso|date('n')] ~ ' de ' ~ reserva.fechaIngreso|date('Y') %}
    {% elseif reserva.fechaIngreso|date('Y') == reserva.fechaEgreso|date('Y') %}
        {% set periodo = reserva.fechaIngreso|date('j') ~ ' de ' ~ meses[reserva.fechaIngreso|date('n')] ~ ' – ' ~ reserva.fechaEgreso|date('j') ~ ' de ' ~ meses[reserva.fechaEgreso|date('n')] ~ ' de ' ~ reserva.fechaIngreso|date('Y') %}
    {% else %}
        {% set periodo = reserva.fechaIngreso|date('j') ~ ' de ' ~ meses[reserva.fechaIngreso|date('n')] ~ ' de ' ~ reserva.fechaIngreso|date('Y') ~ ' – ' ~ reserva.fechaEgreso|date('j') ~ ' de ' ~ meses[reserva.fechaEgreso|date('n')] ~ ' de ' ~ reserva.fechaEgreso|date('Y') %}
    {% endif %}
    <article class="trip">
        <div class="tinfo">
            <h3>Habitación {{ habitacion.numero }} · {{ tipoNombre[habitacion.tipo.value] }}</h3>
            <div class="tdates">{{ periodo }}</div>
            <div class="tmeta">Reserva #{{ reserva.id }}<br>{{ reserva.cantidadHuespedes }} huésp. · Total ${{ reserva.total|number_format(0, ',', '.') }}</div>
            {# acciones: las hace Lucas (CU013) #}
            <div class="tact">
                {% include 'mis_reservas/_acciones.html.twig' with {reserva: reserva} %}
            </div>
        </div>
        <div class="tph">
            {% if portada %}
                <img src="{{ asset('img/habitaciones/' ~ portada.ruta) }}" alt="">
            {% endif %}
            <span class="pill">{{ pill[reserva.estado.value] }}</span>
        </div>
    </article>
{% endmacro %}

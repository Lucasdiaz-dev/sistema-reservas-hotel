{% if reserva.estado.value == 'CANCELACION_PENDIENTE' %}
    <span class="muted" style="font-size:12px">El hotel está revisando tu cancelación.</span>
{% elseif reserva.estado.value in ['PENDIENTE', 'CONFIRMADA'] %}
    {% if puede_cancelar(reserva, app.user) %}
        <details class="confirm">
            <summary class="btn danger">Cancelar</summary>
            <div class="confirmbox">
                {% if reserva.estado.value == 'PENDIENTE' %}
                    <p>¿Seguro que querés cancelar la reserva <b>#{{ reserva.id }}</b>? Como todavía está pendiente, se cancela en el momento. Esta acción no se puede deshacer.</p>
                {% else %}
                    <p>¿Seguro que querés cancelar la reserva <b>#{{ reserva.id }}</b>? Como ya está confirmada, queda pendiente de cancelación hasta que el hotel la confirme. Esta acción no se puede deshacer.</p>
                {% endif %}
                <form method="post" action="{{ path('app_reserva_cancelar', {id: reserva.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reserva' ~ reserva.id) }}">
                    <div class="row" style="justify-content:flex-end">
                        <a class="btn" href="{{ path('app_mis_reservas') }}">Volver</a>
                        <button class="btn dark" type="submit">Confirmar</button>
                    </div>
                </form>
            </div>
        </details>
    {% else %}
        <span class="muted" style="font-size:12px" title="La cancelación solo está disponible hasta 24 h antes del check-in (14:00)">Ya no se puede cancelar: faltan menos de 24 h para el check-in.</span>
    {% endif %}
{% endif %}

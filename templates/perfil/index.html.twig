{% extends 'base.html.twig' %}

{% block body %}
    <div class="crumbs">Inicio › Mi perfil</div>
    <h1>Mi perfil</h1>
    {{ form_start(formulario, {'attr': {'class': 'form', 'novalidate': 'novalidate'}}) }}
        <div class="full">{{ form_errors(formulario) }}</div>
        {% for campo, etiqueta in {'nombre': 'Nombre', 'apellido': 'Apellido', 'email': 'Email', 'telefono': 'Teléfono'} %}
            <div{% if campo in ['email', 'telefono'] %} class="full"{% endif %}>
                <label for="{{ attribute(formulario, campo).vars.id }}">{{ etiqueta }} <span class="req">*</span></label>
                {{ form_errors(attribute(formulario, campo)) }}
                {{ form_widget(attribute(formulario, campo)) }}
            </div>
        {% endfor %}
        <details class="full panel"{% if formulario.nuevaContrasena.vars.errors|length or formulario.nuevaContrasena.first.vars.errors|length or formulario.nuevaContrasena.second.vars.errors|length %} open{% endif %}>
            <summary><b>Cambiar contraseña (opcional)</b></summary>
            {{ form_errors(formulario.nuevaContrasena) }}
            <div class="form">
                <div>
                    {{ form_label(formulario.nuevaContrasena.first) }}
                    {{ form_errors(formulario.nuevaContrasena.first) }}
                    {{ form_widget(formulario.nuevaContrasena.first) }}
                </div>
                <div>
                    {{ form_label(formulario.nuevaContrasena.second) }}
                    {{ form_errors(formulario.nuevaContrasena.second) }}
                    {{ form_widget(formulario.nuevaContrasena.second) }}
                </div>
            </div>
        </details>
        <div class="full row">
            <button class="btn dark" type="submit">Guardar cambios</button>
        </div>
    {{ form_end(formulario) }}
{% endblock %}

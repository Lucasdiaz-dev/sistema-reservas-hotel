{% set ruta = app.request.attributes.get('_route')|default('') %}
<header class="top">
  <a class="brand" href="{{ path('app_busqueda') }}"><span class="logo"><span class="logo"><img src="{{ asset('img/_logo_puente.svg') }}" alt="Hotel Litoral" style="width:100%;height:100%"></span></span>Hotel Litoral</a>
  <nav class="pillnav">
    {% if is_granted('ROLE_ADMIN') %}
      <a href="{{ path('admin_reservas') }}"{% if ruta starts with 'admin_reserva' %} class="on"{% endif %}>Reservas</a><a href="{{ path('admin_habitaciones') }}"{% if ruta starts with 'admin_habitacion' %} class="on"{% endif %}>Habitaciones</a><a href="{{ path('admin_usuarios') }}"{% if ruta starts with 'admin_usuario' %} class="on"{% endif %}>Usuarios</a>
    {% else %}
      <a href="{{ path('app_busqueda') }}"{% if ruta == 'app_busqueda' %} class="on"{% endif %}>Buscar</a><a href="{{ path('app_mis_reservas') }}"{% if ruta == 'app_mis_reservas' %} class="on"{% endif %}>Mis reservas</a><a href="{{ path('app_perfil') }}"{% if ruta == 'app_perfil' %} class="on"{% endif %}>Mi perfil</a>
    {% endif %}
  </nav>
  <div class="user">
    {% if app.user %}
      <span class="avatar"></span>{{ app.user.nombre }} · <a href="{{ path('app_logout') }}" class="muted">Salir</a>
    {% else %}
      <a class="btn" href="{{ path('app_login') }}">Iniciar sesión</a><a class="btn dark" href="{{ path('app_register') }}">Registrarse</a>
    {% endif %}
  </div>
</header>

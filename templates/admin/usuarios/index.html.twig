{% extends 'base.html.twig' %}

{% block title %}Gestión de usuarios{% endblock %}

{% block body %}
    <div class="crumbs">Admin › Usuarios</div>
    <div class="toolbar"><h1>Usuarios</h1></div>
    <form class="searchbar" method="get" action="{{ path('admin_usuarios') }}" role="search" style="margin-bottom:14px">
        <div>
            <label for="buscar-usuarios">Buscar</label>
            <input id="buscar-usuarios" type="text" name="q" value="{{ q }}" placeholder="Buscar por nombre o email" autocomplete="off">
        </div>
        <button class="btn dark" type="submit">Buscar</button>
        <a class="btn" href="{{ path('admin_usuarios') }}">Limpiar</a>
    </form>
    <table class="table">
        <thead><tr><th>Nombre</th><th>Apellido</th><th>Email</th><th>Teléfono</th><th>Rol</th><th>Editar</th></tr></thead>
        <tbody>
            {% for usuario in usuarios %}
                <tr>
                    <td>{{ usuario.nombre }}</td>
                    <td>{{ usuario.apellido }}</td>
                    <td>{{ usuario.email }}</td>
                    <td>{{ usuario.telefono }}</td>
                    <td>
                        {% if 'ROLE_ADMIN' in usuario.roles %}
                            <span class="badge role adm">ADMINISTRADOR</span>
                        {% else %}
                            <span class="badge role">CLIENTE</span>
                        {% endif %}
                    </td>
                    <td>
                        {% set formulario = formularios[usuario.id] %}
                        <button class="btn" type="button" data-user-edit="{{ usuario.id }}">Editar</button>
                        <dialog class="user-modal" data-user-dialog="{{ usuario.id }}"{% if usuarioEditado == usuario.id %} data-open-on-load{% endif %} aria-labelledby="user-modal-title-{{ usuario.id }}">
                            {{ form_start(formulario, {'attr': {'class': 'user-form', 'novalidate': 'novalidate'}}) }}
                                <h2 class="full" id="user-modal-title-{{ usuario.id }}">Editar usuario</h2>
                                {% if formulario.vars.errors|length %}
                                    <div class="full">{{ form_errors(formulario) }}</div>
                                {% endif %}
                                {% for campo, etiqueta in {'nombre': 'Nombre', 'apellido': 'Apellido', 'email': 'Email', 'telefono': 'Teléfono', 'rol': 'Rol'} %}
                                    <div{% if campo in ['email', 'telefono', 'rol'] %} class="full"{% endif %}>
                                        {{ form_label(attribute(formulario, campo), etiqueta) }}
                                        {{ form_widget(attribute(formulario, campo)) }}
                                        {{ form_errors(attribute(formulario, campo)) }}
                                    </div>
                                {% endfor %}
                                <div class="full user-modal-actions">
                                    <button class="btn" type="button" data-user-cancel>Cancelar</button>
                                    <button class="btn dark" type="submit">Guardar</button>
                                </div>
                            {{ form_end(formulario) }}
                        </dialog>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">{% if q %}No se encontraron usuarios{% else %}No hay usuarios registrados.{% endif %}</td></tr>
            {% endfor %}
        </tbody>
    </table>
    <script>
        (function () {
            document.querySelectorAll("[data-user-dialog]").forEach(function (dialog) {
                var opener = document.querySelector('[data-user-edit="' + dialog.getAttribute("data-user-dialog") + '"]');

                function focusFirstField() {
                    var field = dialog.querySelector("input:not([type='hidden']), select, textarea");
                    if (field) {
                        field.focus();
                    }
                }

                function openModal() {
                    if (!dialog.open) {
                        dialog.showModal();
                    }
                    focusFirstField();
                }

                if (opener) {
                    opener.addEventListener("click", openModal);
                }

                var cancel = dialog.querySelector("[data-user-cancel]");
                if (cancel) {
                    cancel.addEventListener("click", function () {
                        dialog.close();
                    });
                }

                dialog.addEventListener("keydown", function (event) {
                    if (event.key !== "Escape") {
                        return;
                    }
                    event.preventDefault();
                    dialog.close();
                });

                dialog.addEventListener("click", function (event) {
                    var rect = dialog.getBoundingClientRect();
                    var outside = event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
                    if (outside) {
                        dialog.close();
                    }
                });

                dialog.addEventListener("close", function () {
                    if (opener) {
                        opener.focus();
                    }
                });

                if (dialog.hasAttribute("data-open-on-load")) {
                    openModal();
                }
            });
        })();
    </script>
{% endblock %}

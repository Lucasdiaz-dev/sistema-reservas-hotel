{% extends 'base.html.twig' %}

{% block title %}Administración de habitaciones{% endblock %}

{% block body %}
    <p class="crumbs">Administración / Habitaciones</p>
    <h1>Habitaciones</h1>

    {% for message in app.flashes('success') %}
        <p class="muted">{{ message }}</p>
    {% endfor %}

    <table class="table">
        <thead>
            <tr>
                <th>Portada</th>
                <th>Número</th>
                <th>Tipo</th>
                <th>Capacidad</th>
                <th>Precio por noche</th>
                <th>Estrellas</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {% for habitacion in habitaciones %}
                {% set portada = null %}

                {% for imagen in habitacion.imagenHabitacions %}
                    {% if imagen.portada %}
                        {% set portada = imagen %}
                    {% endif %}
                {% endfor %}

                <tr>
                    <td>
                        {% if portada %}
                            <img
                                class="thumb"
                                src="{{ asset('img/habitaciones/' ~ portada.ruta) }}"
                                alt="Portada de la habitación {{ habitacion.numero }}"
                            >
                        {% else %}
                            <span class="muted">Sin portada</span>
                        {% endif %}
                    </td>
                    <td>{{ habitacion.numero }}</td>
                    <td>{{ habitacion.tipo.value }}</td>
                    <td>{{ habitacion.capacidadMaxima }}</td>
                    <td>${{ habitacion.precioPorNoche|number_format(0, ',', '.') }}</td>
                    <td>{{ habitacion.estrellas }} / 5</td>
                    <td>
                        {% if habitacion.activa %}
                            <span class="badge">Activa</span>
                        {% else %}
                            <span class="badge cancel">Inactiva</span>
                        {% endif %}
                    </td>
                    <td>
                        <button class="btn" type="button" disabled>
                            Editar
                        </button>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">No hay habitaciones registradas.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
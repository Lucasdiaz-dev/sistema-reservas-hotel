{% extends 'base.html.twig' %}

{% block title %}{{ titulo }}{% endblock %}

{% block body %}
    <p class="crumbs">Administración / Habitaciones / {{ titulo }}</p>
    <h1>{{ titulo }}</h1>

    <div class="panel">
        {{ form_start(formulario, {'attr': {'novalidate': 'novalidate'}}) }}

            {{ form_errors(formulario) }}

            {{ form_row(formulario.numero) }}
            {{ form_row(formulario.tipo) }}
            {{ form_row(formulario.capacidadMaxima) }}
            {{ form_row(formulario.precioPorNoche) }}
            {{ form_row(formulario.descripcion) }}
            {{ form_row(formulario.estrellas) }}
            {{ form_row(formulario.activa) }}

            {% if mostrarImagenes %}
                <h2>Imágenes de la habitación</h2>

                <p class="muted">
                    Seleccioná al menos una imagen y elegí una de ellas como portada.
                </p>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Imagen</th>
                            <th>Asignar</th>
                            <th>Portada</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for archivo in imagenesDisponibles %}
                            <tr>
                                <td>
                                    <img
                                        src="{{ asset('img/habitaciones/' ~ archivo) }}"
                                        alt="{{ archivo }}"
                                        width="140"
                                    >
                                    <p class="muted">{{ archivo }}</p>
                                </td>
                                <td>
                                    <label class="check">
                                        <input
                                            type="checkbox"
                                            name="sel[]"
                                            value="{{ archivo }}"
                                            {% if archivo in seleccionadas %}
                                                checked
                                            {% endif %}
                                        >
                                        Asignar
                                    </label>
                                </td>
                                <td>
                                    <label class="radio">
                                        <input
                                            type="radio"
                                            name="portada"
                                            value="{{ archivo }}"
                                            {% if archivo == portada %}
                                                checked
                                            {% endif %}
                                        >
                                        Portada
                                    </label>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3">
                                    No hay imágenes disponibles.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            <button type="submit" class="btn dark">
                Guardar habitación
            </button>

            <a href="{{ path('admin_habitaciones') }}" class="btn">
                Cancelar
            </a>

        {{ form_end(formulario) }}
    </div>
{% endblock %}
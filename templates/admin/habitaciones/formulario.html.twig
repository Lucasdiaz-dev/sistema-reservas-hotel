{% extends 'base.html.twig' %}

{% block title %}Nueva habitación{% endblock %}

{% block body %}
    <p class="crumbs">Administración / Habitaciones / Nueva</p>
    <h1>Nueva habitación</h1>

    <div class="panel">
        {{ form_start(formulario, {'attr': {'novalidate': 'novalidate'}}) }}

            {{ form_errors(formulario) }}

            {{ form_row(formulario.numero) }}
            {{ form_row(formulario.tipo) }}
            {{ form_row(formulario.capacidadMaxima) }}
            {{ form_row(formulario.precioPorNoche) }}
            {{ form_row(formulario.descripcion) }}
            {{ form_row(formulario.estrellas) }}
            {{ form_row(formulario.activa) }}

            <button type="submit" class="btn dark">
                Guardar habitación
            </button>

            <a href="{{ path('admin_habitaciones') }}" class="btn">
                Cancelar
            </a>

        {{ form_end(formulario) }}
    </div>
{% endblock %}
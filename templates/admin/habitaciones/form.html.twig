{% extends 'base.html.twig' %}

{% block title %}{{ titulo }}{% endblock %}

{% block body %}
    <div class="crumbs">Admin › Habitaciones › {{ titulo }}</div>

    <h1>{{ titulo }}</h1>

    {{ form_start(formulario, {
        'attr': {
            'class': 'form',
            'novalidate': 'novalidate',
            'enctype': 'multipart/form-data'
        }
    }) }}

        {% if formulario.vars.errors|length > 0 %}
            <div class="full">
                {{ form_errors(formulario) }}
            </div>
        {% endif %}

        <div>
            <label for="{{ formulario.numero.vars.id }}">
                Número <span class="req">*</span>
            </label>
            {{ form_errors(formulario.numero) }}
            {{ form_widget(formulario.numero) }}
        </div>

        <div>
            <label for="{{ formulario.tipo.vars.id }}">
                Tipo <span class="req">*</span>
            </label>
            {{ form_errors(formulario.tipo) }}
            {{ form_widget(formulario.tipo) }}
        </div>

        <div>
            <label for="{{ formulario.capacidadMaxima.vars.id }}">
                Capacidad máxima <span class="req">*</span>
            </label>
            {{ form_errors(formulario.capacidadMaxima) }}
            {{ form_widget(formulario.capacidadMaxima) }}
        </div>

        <div>
            <label for="{{ formulario.precioPorNoche.vars.id }}">
                Precio por noche ($) <span class="req">*</span>
            </label>
            {{ form_errors(formulario.precioPorNoche) }}
            {{ form_widget(formulario.precioPorNoche) }}
        </div>

        <div>
            <label for="{{ formulario.estrellas.vars.id }}">
                Estrellas <span class="req">*</span>
            </label>
            {{ form_errors(formulario.estrellas) }}
            {{ form_widget(formulario.estrellas) }}
        </div>

        <div></div>

        <div class="full">
            {{ form_label(formulario.descripcion) }}
            {{ form_errors(formulario.descripcion) }}
            {{ form_widget(formulario.descripcion, {
                'attr': {'rows': 3}
            }) }}
        </div>

        <div class="full">
            <label class="check" for="{{ formulario.activa.vars.id }}">
                {{ form_widget(formulario.activa) }}
                Activa
            </label>
            {{ form_errors(formulario.activa) }}
        </div>

        <div class="full imgsec">
            <div class="row">
                <h2>Imágenes</h2>
            </div>

            <div class="imgtools">
                <button type="button" class="btn" data-imagen-abrir="elegir">Elegir imágenes</button>
                <button type="button" class="btn" data-imagen-abrir="imagen">Subir nuevas imágenes</button>
            </div>

            <dialog class="user-modal picker" id="modal-elegir" aria-labelledby="modal-elegir-titulo">
                <h2 id="modal-elegir-titulo">Elegir imágenes</h2>
                <div class="pickgrid">
                    {% for archivo in imagenesDisponibles %}
                        <label class="pick">
                            <input
                                id="seleccion-{{ loop.index }}"
                                type="checkbox"
                                name="sel[]"
                                value="{{ archivo }}"
                                {% if archivo in seleccionadas %}
                                    checked
                                {% endif %}
                            >
                            <img
                                src="{{ asset('img/habitaciones/' ~ archivo) }}"
                                alt="{{ archivo }}"
                            >
                            <span>{{ archivo }}</span>
                        </label>
                    {% else %}
                        <p class="muted">No hay imágenes disponibles.</p>
                    {% endfor %}
                </div>
                <p class="help">Marcá las imágenes y presioná Aceptar para elegir la portada.</p>
                <div class="user-modal-actions">
                    <button class="btn" type="button" data-imagen-cerrar>Cancelar</button>
                    <button id="actualizar-imagenes" class="btn dark" type="submit" name="accion" value="actualizar">Aceptar</button>
                </div>
            </dialog>

            <dialog class="user-modal" id="modal-imagen" aria-labelledby="modal-imagen-titulo"{% if errorSubida %} data-open-on-load{% endif %}>
                <h2 id="modal-imagen-titulo">Subir nuevas imágenes</h2>
                <label for="imagen-habitacion">Foto</label>
                <input type="hidden" name="MAX_FILE_SIZE" value="{{ tamanoMaximo }}">
                <input
                    id="imagen-habitacion"
                    type="file"
                    name="imagen"
                    accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                >
                {% if errorSubida %}
                    <p class="err">{{ errorSubida }}</p>
                {% endif %}
                <p class="help">JPG, PNG o WebP. Tamaño máximo: 5 MB.</p>
                <div class="user-modal-actions">
                    <button class="btn" type="button" data-imagen-cerrar>Cancelar</button>
                    <button class="btn dark" type="submit" name="accion" value="subir">Subir imagen</button>
                </div>
            </dialog>

            <h3>
                Imágenes asignadas
                <span class="muted">· marcá cuál es la portada</span>
            </h3>

            <div class="asggrid">
                {% for archivo in imagenesDisponibles %}
                    {% if archivo in seleccionadas %}
                        <div class="asg">
                            <img
                                src="{{ asset('img/habitaciones/' ~ archivo) }}"
                                alt="{{ archivo }}"
                            >

                            <label class="radio">
                                <input
                                    type="radio"
                                    name="portada"
                                    value="{{ archivo }}"
                                    {% if archivo == portada %}
                                        checked
                                    {% endif %}
                                >
                                Portada
                            </label>

                            <a
                                class="muted"
                                href="#seleccion-{{ loop.index }}"
                                title="Desasigna la imagen; el archivo no se borra"
                                onclick="
                                    document.getElementById('seleccion-{{ loop.index }}').checked = false;
                                    document.getElementById('actualizar-imagenes').click();
                                    return false;
                                "
                            >
                                Quitar
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            {% if seleccionadas|length == 0 %}
                <p class="muted">Todavía no seleccionaste imágenes.</p>
            {% endif %}
        </div>

        <div class="full">
            <button
                type="submit"
                name="accion"
                value="guardar"
                class="btn dark"
            >
                Confirmar
            </button>

            <a href="{{ path('admin_habitaciones') }}" class="btn">
                Cancelar
            </a>
        </div>

    {{ form_end(formulario) }}
    <script>
        (function () {
            function bindModal(dialog) {
                if (!dialog) {
                    return;
                }

                function openModal() {
                    if (!dialog.open) {
                        dialog.showModal();
                    }
                    var field = dialog.querySelector("input[type='file']");
                    if (field) {
                        field.focus();
                    }
                }

                document.querySelectorAll('[data-imagen-abrir="' + dialog.id.replace("modal-", "") + '"]').forEach(function (opener) {
                    opener.addEventListener("click", openModal);
                });

                var cerrar = dialog.querySelector("[data-imagen-cerrar]");
                if (cerrar) {
                    cerrar.addEventListener("click", function () {
                        dialog.close();
                    });
                }

                dialog.addEventListener("click", function (event) {
                    var rect = dialog.getBoundingClientRect();
                    var outside = event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
                    if (outside) {
                        dialog.close();
                    }
                });

                if (dialog.hasAttribute("data-open-on-load")) {
                    openModal();
                }
            }

            bindModal(document.getElementById("modal-elegir"));
            bindModal(document.getElementById("modal-imagen"));
        })();
    </script>
{% endblock %}